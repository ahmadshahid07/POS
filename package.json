{
  "name": "skyths-business-management",
  "version": "1.0.0",
  "description": "SKYTHS — Offline Desktop Inventory, POS, Sales, Accounting & Business Management System",
  "main": "dist-electron/electron/main.js",
  "author": "SKYTHS Systems",
  "license": "Proprietary",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs = require('fs'); const path = require('path'); fs.mkdirSync('dist-electron/electron/db', {recursive: true}); fs.copyFileSync('electron/db/schema.sql', 'dist-electron/electron/db/schema.sql');\"",
    "build": "npm run build:vite && npm run build:electron",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.16.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.skyths.inventory",
    "productName": "SKYTHS Business Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/better-sqlite3/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SKYTHS"
    }
  }
}
